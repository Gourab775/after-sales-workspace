# AI provider (OpenAI-compatible). Primary is OpenRouter; any compatible
# gateway works — just point BASE_URL at it and set the matching MODEL.
AI_GATEWAY_API_KEY=your-openrouter-api-key
AI_GATEWAY_BASE_URL=https://openrouter.ai/api/v1

# Model (defaults to deepseek/deepseek-chat)
# AI_GATEWAY_MODEL=deepseek/deepseek-chat

# Optional backup provider — automatic failover when the primary errors.
# AI_GATEWAY_BACKUP_API_KEY=your-backup-api-key
# AI_GATEWAY_BACKUP_BASE_URL=https://backup-gateway.example.com/v1
# AI_GATEWAY_BACKUP_MODEL=deepseek/deepseek-chat

# Aliases (either naming works; SERVICE_* takes docs precedence)
# SERVICE_API_KEY=your-api-key
# SERVICE_BASE_URL=your-gateway-url
# SERVICE_MODEL=@makers/deepseek-v4-flash

# Neon Postgres (required for persistent storage on Next.js/Vercel/local runtimes)
# Create a project at https://console.neon.tech and paste the pooled connection string.
# Database: after_sales (tables are created automatically on first request)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.c-4.ap-southeast-1.aws.neon.tech/after_sales?sslmode=require&channel_binding=require
